<%layout ("/layouts/boilerplate")%>

<div class="row">
    <div class="col-8 offset-3">
          <h3 style="margin-top: 1rem;"> <%= listing.title %></h3> 
    <div  class="card" >
         <div class="card-body">
          <p class="card-text">  </p>
  </div>
    </div class=" listing-card">
    <img  class="card-img-top" src="<%= listing.displayImageUrl || (listing.image ? listing.image.url : '') %>" alt="listing image" style="max-width: 40rem;">
    <ul>
        
        <li> <%= listing.description %></li>
        <li> &#8377; <%= listing.price.toLocaleString("en-IN") %></li>
        <li> <%= listing.location %></li>
        <li> <%= listing.Country %></li>
    </ul>
    <br>
      <a href="/listings/<%= listing._id %>/edit">
        <button class="btn btn-primary">Edit</button>
    </a>
    <br><br>
    <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
        <button type="submit" class="btn btn-danger">Delete</button>
    </form>

</div>

<div  class="col-8 offset-3 mb-3">
    <hr>
    <h4> leave a review</h4>
    <form  action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
        <div class="mb-3 mt-3">
            <label for="Reting" class="form-label">Reting</label>
            <input type="range" id="Reting" name="review[rating]" class="form-range" min="1" max="5">
        </div>


        <div class="mb-3 mt-3">
            <label for="coment" class="form-label">coment</label>
            <textarea id="coment" name="review[coment]" rows="5" cols="30" class="form-control" required></textarea>
            <div class="invalid-feedback">
                Please enter a comment.
            </div>
        </div>

        <button type="submit" class="btn btn-primary">sumbit</button>
    </form>

    <hr>
   <p><b> All Reviews</b></p>

    <% for(let review of listing.reviews) { %>
        <div>
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Ankit yadav</h5>
                    <p class="card-text"><%= review.coment %></p>
                    <p class="card-text"><%= review.rating %></p>
                </div>
            </div>
        </div>
    <% } %>


</div>
</div>
    
   
    