<%layout ("/layouts/boilerplate")%>

<div class="row">
    <div class="col-8 offset-3">
          <h3 style="margin-top: 1rem;"> <%= listing.title %></h3> 
    <div  class="card" >
         <div class="card-body">
          <p class="card-text">  </p>
  </div>
    </div>
    <img  class="card-img-top" src="<%= listing.displayImageUrl || (listing.image ? listing.image.url : '') %>" alt="listing image" style="max-width: 40rem;">
    <ul>
        
        <li> <%= listing.description %></li>
        <li> &#8377; <%= listing.price.toLocaleString("en-IN") %></li>
        <li> <%= listing.location %></li>
        <li> <%= listing.Country %></li>
    </ul>
    <br>
      <a href="/listings/<%= listing._id %>/edit">
        <button class="btn btn-primary">Edit</button>
    </a>
    <br><br>
    <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
        <button type="submit" class="btn btn-danger">Delete</button>
    </form>

</div>

<div  class="col-8 offset-3">
    <hr>
    <h4> leave a review</h4>
    <form>
        <div>
            <label for="Reting">Reting</label>
            <input type="range" id="Reting" name="review[rating]" min="1" max="5">
        </div>


        <div>
            <label for="coment">coment</label>
            <textarea id="coment" name="review[coment]" rows="10" cols="30"></textarea>
        </div>

        <button type="submit">sumbit</button>
    </form>

</div>


</div>
    
   
    