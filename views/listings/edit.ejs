<%layout ("/layouts/boilerplate")%>
    <h3>edit listing:</h3>
    <form method="POST" action="/listings/<%= listing._id %>?_method=PUT">

       <div>
                 <label  for="title" class="form-label">Title</label>
                 <input name="title" type="text" placeholder=" enter title" value="<%= listing.title %>">
       </div>

       <div> 
                 <label  for="description" class="form-label">Description</label>
                 <textarea name="description" placeholder=" enter description"><%= listing.description %></textarea>
       </div>
       
        <div>
                <label  for="image" class="form-label">Image URL</label>
               <input name="image" type="text" placeholder=" enter image url" value="<%= listing.displayImageUrl || (listing.image ? listing.image.url : '') %>">
        </div>
        
       <div>
            <label  for="price" class="form-label">Price</label>
             <input name="price" type="number" placeholder=" enter price" value="<%= listing.price %>">
    </div>
        
    <div> 
            <label  for="Country" class="form-label">Country</label>
            <input name="Country" type="text" placeholder=" enter country" value="<%= listing.Country %>">
    
    </div>
           
<div>
       <label  for="location" class="form-label">Location</label>
        <input name="location" type="text" placeholder=" enter location" value="<%= listing.location %>">
</div>
       
       
        <button type="submit">Update</button>
    </form>
